# AICorp secrets. Copy this file to secrets.env, fill in the values yourself and keep it private (chmod 600).
# secrets.env is ignored by git. Never paste these values into chat messages, issues or logs.
# No quotes, no spaces around "=". Leave a line empty if you do not use that feature.

# --- Telegram (create a bot with @BotFather: /newbot, then copy the token) ---
TELEGRAM_BOT_TOKEN=
# Leave empty at first. Send any message to your bot, then run scripts/check_notifications.py: it finds the chat id and saves it here.
TELEGRAM_CHAT_ID=

# --- Gmail (needs 2-Step Verification, IMAP enabled in Gmail settings, and an App Password) ---
GMAIL_ADDRESS=
# 16 characters; you may write it without spaces
GMAIL_APP_PASSWORD=
# Where alerts are delivered (can be the same Gmail address)
ALERT_EMAIL_TO=
